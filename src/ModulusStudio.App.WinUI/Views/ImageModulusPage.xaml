<Page
    x:Class="ModulusStudio.App.WinUI.Views.ImageModulusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Spacing="12">

            <TextBlock Text="图片取模" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8" />

            <!-- 预览 -->
            <Border Style="{StaticResource SettingsCard}" Padding="16"
                    AllowDrop="True" DragOver="DropArea_DragOver" Drop="DropArea_Drop">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="图片预览" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ImageInfo}" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Border Background="#111318" CornerRadius="4" Height="260">
                        <Grid>
                            <TextBlock Text="拖入 BMP / JPG / GIF / ICO / PNG / EMF / WMF 图片"
                                       Foreground="#5C6577"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="10" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="打开图片" Command="{Binding OpenCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="清空" Command="{Binding ClearCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 输出设置 -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="颜色深度" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="决定每个像素占用的位数" Style="{StaticResource FieldLabel}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" Width="220"
                                  ItemsSource="{Binding DepthNames}"
                                  SelectedIndex="{Binding DepthIndex, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A9;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="扫描方向" Style="{StaticResource RowTitle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" Width="220"
                                  ItemsSource="{Binding ScanNames}"
                                  SelectedIndex="{Binding ScanIndex, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="代码格式" Style="{StaticResource RowTitle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" Width="220"
                                  ItemsSource="{Binding FormatNames}"
                                  SelectedIndex="{Binding FormatIndex, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="每行字节数" Style="{StaticResource RowTitle}" />
                        </StackPanel>
                        <NumberBox x:Name="BytesPerLineBox" Grid.Column="2" Width="110" VerticalAlignment="Center"
                                   Minimum="1" Maximum="80" SmallChange="1"
                                   Tag="bytesPerLine" ValueChanged="NumberBox_ValueChanged" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D2;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="单色阈值" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="转换为单色时使用的亮度分界" Style="{StaticResource FieldLabel}" />
                        </StackPanel>
                        <NumberBox x:Name="ThresholdBox" Grid.Column="2" Width="110" VerticalAlignment="Center"
                                   Minimum="0" Maximum="255" SmallChange="1"
                                   Tag="threshold" ValueChanged="NumberBox_ValueChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 字节排列 -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8AB;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="字节高位在前" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="每个字节内 bit7 对应第一个像素" Style="{StaticResource FieldLabel}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsOn="{Binding MsbFirst, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8AB;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="低字节在前" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="多字节像素按小端顺序输出" Style="{StaticResource FieldLabel}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsOn="{Binding LowByteFirst, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8AB;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="字节内反序" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="输出前逐字节反转位序" Style="{StaticResource FieldLabel}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsOn="{Binding ReverseBits, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A9;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="排列方向" Style="{StaticResource RowTitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <CheckBox Content="自右至左" MinWidth="0" IsChecked="{Binding RightToLeft}" />
                            <CheckBox Content="自底至顶" MinWidth="0" IsChecked="{Binding BottomToTop}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="颜色处理" Style="{StaticResource RowTitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <CheckBox Content="反色" MinWidth="0" IsChecked="{Binding InvertColors}" />
                            <CheckBox Content="包含 BMP 文件头" MinWidth="0" IsChecked="{Binding IncludeHeader}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 图像调整 -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="亮度" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="取值范围 -100 ~ 100" Style="{StaticResource FieldLabel}" />
                        </StackPanel>
                        <NumberBox x:Name="BrightnessBox" Grid.Column="2" Width="110" VerticalAlignment="Center"
                                   Minimum="-100" Maximum="100" SmallChange="1"
                                   Tag="brightness" ValueChanged="NumberBox_ValueChanged" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="对比度" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="取值范围 -100 ~ 100" Style="{StaticResource FieldLabel}" />
                        </StackPanel>
                        <NumberBox x:Name="ContrastBox" Grid.Column="2" Width="110" VerticalAlignment="Center"
                                   Minimum="-100" Maximum="100" SmallChange="1"
                                   Tag="contrast" ValueChanged="NumberBox_ValueChanged" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7C3;" Style="{StaticResource RowIcon}" />
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="最大尺寸" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="0 表示不限制，超出时等比缩小" Style="{StaticResource FieldLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <NumberBox x:Name="MaxWidthBox" Width="110" Minimum="0" Maximum="4096" SmallChange="1"
                                       PlaceholderText="宽" Tag="maxWidth" ValueChanged="NumberBox_ValueChanged" />
                            <NumberBox x:Name="MaxHeightBox" Width="110" Minimum="0" Maximum="4096" SmallChange="1"
                                       PlaceholderText="高" Tag="maxHeight" ValueChanged="NumberBox_ValueChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 取模数据 -->
            <Border Style="{StaticResource SettingsCard}" Padding="16">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="取模数据" FontSize="14" FontWeight="SemiBold" />
                    <TextBox Grid.Row="1" Height="280"
                             Text="{Binding OutputCode, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="{StaticResource CodeFont}"
                             FontSize="12"
                             Padding="10"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>

            <!-- 操作 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="复制代码" Command="{Binding CopyCommand}" />
                    <Button Content="保存数据" Command="{Binding SaveBinaryCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
