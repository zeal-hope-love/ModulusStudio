<Page
    x:Class="ModulusStudio.App.WinUI.Views.ImageModulusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="24,20,24,20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧参数 -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource PanelCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="源图片" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding ImageInfo}" Style="{StaticResource FieldLabel}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="打开图片" Command="{Binding OpenCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="清空" Command="{Binding ClearCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="输出设置" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="颜色深度" Style="{StaticResource FieldLabel}" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding DepthNames}"
                                  SelectedIndex="{Binding DepthIndex, Mode=TwoWay}" />

                        <TextBlock Text="扫描方向" Style="{StaticResource FieldLabel}" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ScanNames}"
                                  SelectedIndex="{Binding ScanIndex, Mode=TwoWay}" />

                        <TextBlock Text="代码格式" Style="{StaticResource FieldLabel}" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding FormatNames}"
                                  SelectedIndex="{Binding FormatIndex, Mode=TwoWay}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="每行字节数" Style="{StaticResource FieldLabel}" />
                                <NumberBox x:Name="BytesPerLineBox" Minimum="1" Maximum="80" SmallChange="1"
                                           Tag="bytesPerLine" ValueChanged="NumberBox_ValueChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="单色阈值" Style="{StaticResource FieldLabel}" />
                                <NumberBox x:Name="ThresholdBox" Minimum="0" Maximum="255" SmallChange="1"
                                           Tag="threshold" ValueChanged="NumberBox_ValueChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="字节排列" Style="{StaticResource SectionHeader}" />

                        <ToggleSwitch Header="字节高位在前" MinWidth="0"
                                      IsOn="{Binding MsbFirst, Mode=TwoWay}" />
                        <ToggleSwitch Header="低字节在前" MinWidth="0"
                                      IsOn="{Binding LowByteFirst, Mode=TwoWay}" />
                        <ToggleSwitch Header="字节内反序" MinWidth="0"
                                      IsOn="{Binding ReverseBits, Mode=TwoWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="自右至左" MinWidth="0" IsChecked="{Binding RightToLeft}" />
                            <CheckBox Content="自底至顶" MinWidth="0" IsChecked="{Binding BottomToTop}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="反色" MinWidth="0" IsChecked="{Binding InvertColors}" />
                            <CheckBox Content="包含 BMP 头" MinWidth="0" IsChecked="{Binding IncludeHeader}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="图像调整" Style="{StaticResource SectionHeader}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="亮度" Style="{StaticResource FieldLabel}" />
                                <NumberBox x:Name="BrightnessBox" Minimum="-100" Maximum="100" SmallChange="1"
                                           Tag="brightness" ValueChanged="NumberBox_ValueChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="对比度" Style="{StaticResource FieldLabel}" />
                                <NumberBox x:Name="ContrastBox" Minimum="-100" Maximum="100" SmallChange="1"
                                           Tag="contrast" ValueChanged="NumberBox_ValueChanged" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="最大宽度" Style="{StaticResource FieldLabel}" />
                                <NumberBox x:Name="MaxWidthBox" Minimum="0" Maximum="4096" SmallChange="1"
                                           Tag="maxWidth" ValueChanged="NumberBox_ValueChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="最大高度" Style="{StaticResource FieldLabel}" />
                                <NumberBox x:Name="MaxHeightBox" Minimum="0" Maximum="4096" SmallChange="1"
                                           Tag="maxHeight" ValueChanged="NumberBox_ValueChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 右侧预览与输出 -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelCard}"
                    AllowDrop="True" DragOver="DropArea_DragOver" Drop="DropArea_Drop">
                <StackPanel Spacing="8">
                    <TextBlock Text="图片预览" Style="{StaticResource SectionHeader}" />
                    <Border Background="#111318" CornerRadius="6" Height="300">
                        <Grid>
                            <TextBlock Text="拖入 BMP / JPG / GIF / ICO / PNG / EMF / WMF 图片"
                                       Foreground="#5C6577"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="10" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelCard}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="取模数据" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right"
                                   Style="{StaticResource FieldLabel}" />
                    </Grid>
                    <TextBox Grid.Row="1"
                             Text="{Binding OutputCode, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="{StaticResource CodeFont}"
                             FontSize="12"
                             Padding="10"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="复制代码" Command="{Binding CopyCommand}" />
                <Button Content="保存数据" Command="{Binding SaveBinaryCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
