<Page
    x:Class="ModulusStudio.App.WinUI.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="24,20,24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Spacing="14">
                <Viewbox Width="56" Height="56">
                    <ContentControl ContentTemplate="{StaticResource AppLogoTemplate}" IsTabStop="False" />
                </Viewbox>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="文字图片取模软件" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource FieldLabel}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource PanelCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="软件信息" Style="{StaticResource SectionHeader}" />
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="文字图片取模软件" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="版本" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="VersionRowText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="来源" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"
                                   Text="由 AI 基于原版「文字取模软件」和「图片取模软件」重写，界面使用 WinUI 3。" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="运行环境" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="WinUI 3 · Windows App SDK 2.7 · .NET 10" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="仓库" Style="{StaticResource FieldLabel}" />
                        <HyperlinkButton x:Name="RepoLink" Grid.Row="4" Grid.Column="1" Padding="0"
                                         HorizontalAlignment="Left" Click="RepoLink_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="更新" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="SourceText" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="发现新版本后会自动下载，下载完成时提示重启即可完成更新。"
                       Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
