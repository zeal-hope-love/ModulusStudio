<Page
    x:Class="ModulusStudio.App.WinUI.Views.TextModulusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="24,20,24,20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧参数 -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource PanelCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="字体与点阵" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="字体" Style="{StaticResource FieldLabel}" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding FontFamilies}"
                                  SelectedItem="{Binding SelectedFont, Mode=TwoWay}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="宽" Style="{StaticResource FieldLabel}" />
                                <NumberBox x:Name="CellWidthBox" Minimum="3" Maximum="256" SmallChange="1"
                                           Tag="cellWidth" ValueChanged="NumberBox_ValueChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="高" Style="{StaticResource FieldLabel}" />
                                <NumberBox x:Name="CellHeightBox" Minimum="3" Maximum="256" SmallChange="1"
                                           Tag="cellHeight" ValueChanged="NumberBox_ValueChanged" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="等比缩放" MinWidth="0" IsChecked="{Binding LockAspect, Mode=TwoWay}" />
                            <CheckBox Content="固定宽度" MinWidth="0" IsChecked="{Binding FixedWidth, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <CheckBox Content="加粗" MinWidth="0" IsChecked="{Binding Bold, Mode=TwoWay}" />
                            <CheckBox Content="倾斜" MinWidth="0" IsChecked="{Binding Italic, Mode=TwoWay}" />
                            <CheckBox Content="下划线" MinWidth="0" IsChecked="{Binding Underline, Mode=TwoWay}" />
                        </StackPanel>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="右移像素" Style="{StaticResource FieldLabel}" />
                                <NumberBox x:Name="OffsetXBox" Minimum="-16" Maximum="16" SmallChange="1"
                                           Tag="offsetX" ValueChanged="NumberBox_ValueChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="下移像素" Style="{StaticResource FieldLabel}" />
                                <NumberBox x:Name="OffsetYBox" Minimum="-16" Maximum="16" SmallChange="1"
                                           Tag="offsetY" ValueChanged="NumberBox_ValueChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="取模选项" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="取模方式" Style="{StaticResource FieldLabel}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="ModeTileColumnRow" Grid.Row="0" Grid.Column="0" Tag="columnRow"
                                    Tapped="ModeTile_Tapped" CornerRadius="6" Padding="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Border Background="#DCE2EC" CornerRadius="3" Padding="1">
                                        <Viewbox Height="52">
                                            <Grid x:Name="ModeDemoColumnRow" Width="48" Height="48" Background="#F7F9FC" />
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="列行式" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="ModeTileRowColumn" Grid.Row="0" Grid.Column="1" Tag="rowColumn"
                                    Tapped="ModeTile_Tapped" CornerRadius="6" Padding="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Border Background="#DCE2EC" CornerRadius="3" Padding="1">
                                        <Viewbox Height="52">
                                            <Grid x:Name="ModeDemoRowColumn" Width="48" Height="48" Background="#F7F9FC" />
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="行列式" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="ModeTileColumnMajor" Grid.Row="1" Grid.Column="0" Tag="columnMajor"
                                    Tapped="ModeTile_Tapped" CornerRadius="6" Padding="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Border Background="#DCE2EC" CornerRadius="3" Padding="1">
                                        <Viewbox Height="52">
                                            <Grid x:Name="ModeDemoColumnMajor" Width="48" Height="48" Background="#F7F9FC" />
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="逐列式" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="ModeTileRowMajor" Grid.Row="1" Grid.Column="1" Tag="rowMajor"
                                    Tapped="ModeTile_Tapped" CornerRadius="6" Padding="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Border Background="#DCE2EC" CornerRadius="3" Padding="1">
                                        <Viewbox Height="52">
                                            <Grid x:Name="ModeDemoRowMajor" Width="48" Height="48" Background="#F7F9FC" />
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="逐行式" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="阴码" MinWidth="0" GroupName="Polarity" IsChecked="{Binding IsNegativeCode, Mode=TwoWay}" />
                            <RadioButton Content="阳码" MinWidth="0" GroupName="Polarity" IsChecked="{Binding IsPositiveCode, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="顺向" MinWidth="0" GroupName="BitOrder" IsChecked="{Binding IsForward, Mode=TwoWay}" />
                            <RadioButton Content="逆向" MinWidth="0" GroupName="BitOrder" IsChecked="{Binding IsReversed, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="十六进制" MinWidth="0" GroupName="Radix" IsChecked="{Binding IsHex, Mode=TwoWay}" />
                            <RadioButton Content="十进制" MinWidth="0" GroupName="Radix" IsChecked="{Binding IsDecimal, Mode=TwoWay}" />
                        </StackPanel>

                        <CheckBox Content="重复字符只生成一次" MinWidth="0"
                                  IsChecked="{Binding DedupeRepeats, Mode=TwoWay}" />

                        <TextBlock Text="字符集" Style="{StaticResource FieldLabel}" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding CharsetNames}"
                                  SelectedIndex="{Binding CharsetIndex, Mode=TwoWay}" />

                        <TextBlock Text="渲染后端" Style="{StaticResource FieldLabel}" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding RasterizerNames}"
                                  SelectedIndex="{Binding RasterizerIndex, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="输出格式" Style="{StaticResource SectionHeader}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="格式" Style="{StaticResource FieldLabel}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding FormatNames}"
                                          SelectedIndex="{Binding FormatIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="每行字节数" Style="{StaticResource FieldLabel}" />
                                <NumberBox x:Name="BytesPerLineBox" Minimum="1" Maximum="80" SmallChange="1"
                                           Tag="bytesPerLine" ValueChanged="NumberBox_ValueChanged" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="在数据块前添加字符注释" MinWidth="0"
                                  IsChecked="{Binding AddCharComment, Mode=TwoWay}" />

                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="输出模板" Style="{StaticResource FieldLabel}" />
                            <Button Content="恢复默认" HorizontalAlignment="Right" Padding="8,2" FontSize="12"
                                    Command="{Binding ResetTemplateCommand}" />
                        </Grid>
                        <TextBox x:Name="TemplateBox" Height="132"
                                 Text="{Binding TemplateText, Mode=OneWay}"
                                 AcceptsReturn="True"
                                 FontFamily="{StaticResource CodeFont}"
                                 FontSize="11"
                                 TextWrapping="NoWrap"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                   Text="占位符：/*_char_*/ 字符  /*_index_*/ 序号  /*_w_*/ 宽  /*_h_*/ 高  /*_len_*/ 字节数  /*_data_*/ 字模数据" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 右侧预览与输出 -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelCard}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="点阵预览" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding CellSummary}" HorizontalAlignment="Right"
                                   Style="{StaticResource FieldLabel}" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#111318" CornerRadius="6" Height="180">
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="10" />
                        </Border>
                        <Border Grid.Column="1" Background="#0A0F0C" CornerRadius="6" Height="180">
                            <Image Source="{Binding LcdImage}" Stretch="Uniform" Margin="10" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="输入文字" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="InputTextBox"
                             Text="{Binding InputText, Mode=OneWay}"
                             TextChanged="InputText_TextChanged"
                             FontSize="14" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="字模数据" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right"
                                   Style="{StaticResource FieldLabel}" />
                    </Grid>
                    <TextBox Grid.Row="1"
                             Text="{Binding OutputCode, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="{StaticResource CodeFont}"
                             FontSize="12"
                             Padding="10"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="复制代码" Command="{Binding CopyCommand}" />
                <Button Content="保存代码" Command="{Binding SaveTextCommand}" />
                <Button Content="导出字库" Command="{Binding SaveBinaryCommand}" />
                <Button Content="生成 GB2312 字库" Command="{Binding SaveLibraryCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
