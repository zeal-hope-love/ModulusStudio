<ui:FluentWindow x:Class="ModulusStudio.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:ModulusStudio.App.Views"
                 Title="文字图片取模软件"
                 Width="1200" Height="820"
                 MinWidth="900" MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 WindowState="Maximized"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="文字图片取模软件" ShowMaximize="True" ShowMinimize="True" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#141720" BorderBrush="#232833" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,18,20,12">
                        <TextBlock Text="取模工坊" FontSize="20" FontWeight="Bold" Foreground="#F2F5FA" />
                        <TextBlock Text="Modulus Studio" FontSize="11" Foreground="#6C7689" Margin="0,2,0,0" />
                    </StackPanel>

                    <ListBox x:Name="NavList" Grid.Row="1"
                             SelectedIndex="0"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="NavList_OnSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,11" />
                                <Setter Property="Margin" Value="10,3" />
                                <Setter Property="Foreground" Value="#C6CDDA" />
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1E2430" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2A3A57" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="文字取模" />
                        <ListBoxItem Content="图片取模" />
                    </ListBox>

                    <TextBlock Grid.Row="2" Margin="20,10,20,18"
                               Text="GDI / Skia · C51 / A51 / 自定义"
                               FontSize="11" Foreground="#5C6577" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <views:TextModulusView x:Name="TextView" />
                <views:ImageModulusView x:Name="ImageView" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
