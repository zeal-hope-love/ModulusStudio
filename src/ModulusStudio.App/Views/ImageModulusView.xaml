<UserControl x:Class="ModulusStudio.App.Views.ImageModulusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <Border Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <TextBlock Text="源图片" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:Button Content="打开图片" Command="{Binding OpenCommand}" Appearance="Primary" Margin="0,0,8,0" />
                            <ui:Button Content="清空" Command="{Binding ClearCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ImageInfo}" Foreground="#8A94A6" TextWrapping="Wrap"
                                   FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="输出格式" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />

                        <TextBlock Text="颜色深度" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding DepthNames}" SelectedIndex="{Binding DepthIndex}" Margin="0,0,0,10" />

                        <TextBlock Text="扫描方向" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding ScanNames}" SelectedIndex="{Binding ScanIndex}" Margin="0,0,0,10" />

                        <TextBlock Text="代码格式" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding FormatNames}" SelectedIndex="{Binding FormatIndex}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="每行字节数" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding BytesPerLine, Mode=TwoWay}" Minimum="1" Maximum="80" SmallChange="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="单色阈值" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Threshold, Mode=TwoWay}" Minimum="0" Maximum="255" SmallChange="1" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel>
                            <CheckBox Content="字节高位在前" IsChecked="{Binding MsbFirst}" Margin="0,0,14,8" />
                            <CheckBox Content="字节内反序" IsChecked="{Binding ReverseBits}" Margin="0,0,14,8" />
                            <CheckBox Content="低字节在前" IsChecked="{Binding LowByteFirst}" Margin="0,0,14,8" />
                            <CheckBox Content="自右至左" IsChecked="{Binding RightToLeft}" Margin="0,0,14,8" />
                            <CheckBox Content="自底至顶" IsChecked="{Binding BottomToTop}" Margin="0,0,14,8" />
                            <CheckBox Content="反色" IsChecked="{Binding InvertColors}" Margin="0,0,14,8" />
                            <CheckBox Content="包含 BMP 文件头" IsChecked="{Binding IncludeHeader}" Margin="0,0,14,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="图像调整" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />

                        <TextBlock Text="亮度" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ui:NumberBox Value="{Binding Brightness, Mode=TwoWay}" Minimum="-100" Maximum="100" SmallChange="1" Margin="0,0,0,8" />

                        <TextBlock Text="对比度" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ui:NumberBox Value="{Binding Contrast, Mode=TwoWay}" Minimum="-100" Maximum="100" SmallChange="1" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="最大宽度" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding MaxWidth, Mode=TwoWay}" Minimum="0" Maximum="4096" SmallChange="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="最大高度" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding MaxHeight, Mode=TwoWay}" Minimum="0" Maximum="4096" SmallChange="1" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.9*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelCard}" Margin="0,0,0,12"
                    AllowDrop="True" DragOver="DropArea_OnDragOver" Drop="DropArea_OnDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="图片预览（可直接拖入图片文件）" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Border Grid.Row="1" Background="#111318" CornerRadius="6">
                        <Grid>
                            <TextBlock Text="拖入 BMP / JPG / GIF / ICO / PNG / EMF / WMF 图片"
                                       Foreground="#5C6577"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="10"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="取模数据" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox Grid.Row="1"
                             Text="{Binding OutputCode, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             FontFamily="{StaticResource CodeFont}"
                             FontSize="12"
                             Background="#12151B"
                             Foreground="#B9E4C9"
                             Padding="10"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#8A94A6" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="复制代码" Command="{Binding CopyCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="保存数据" Command="{Binding SaveBinaryCommand}" Appearance="Primary" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
