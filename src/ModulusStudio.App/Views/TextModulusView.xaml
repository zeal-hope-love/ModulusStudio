<UserControl x:Class="ModulusStudio.App.Views.TextModulusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧参数 -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <Border Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <TextBlock Text="字体与点阵" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />

                        <TextBlock Text="字体" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding FontFamilies}"
                                  SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                                  Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="宽" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding CellWidth, Mode=TwoWay}"
                                              Minimum="3" Maximum="256" SmallChange="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="高" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding CellHeight, Mode=TwoWay}"
                                              Minimum="3" Maximum="256" SmallChange="1" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox Content="等比缩放" IsChecked="{Binding LockAspect}" Margin="0,0,16,0" />
                            <CheckBox Content="固定宽度" IsChecked="{Binding FixedWidth}" />
                        </StackPanel>

                        <WrapPanel Margin="0,0,0,8">
                            <CheckBox Content="加粗" IsChecked="{Binding Bold}" Margin="0,0,14,6" />
                            <CheckBox Content="倾斜" IsChecked="{Binding Italic}" Margin="0,0,14,6" />
                            <CheckBox Content="下划线" IsChecked="{Binding Underline}" Margin="0,0,14,6" />
                        </WrapPanel>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="右移像素" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding OffsetX, Mode=TwoWay}"
                                              Minimum="-16" Maximum="16" SmallChange="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="下移像素" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding OffsetY, Mode=TwoWay}"
                                              Minimum="-16" Maximum="16" SmallChange="1" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="取模选项" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />

                        <TextBlock Text="取模方式" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <WrapPanel Margin="0,0,0,10">
                            <RadioButton Content="逐列式" GroupName="ScanMode" IsChecked="{Binding IsColumnMajor}" Margin="0,0,14,6" />
                            <RadioButton Content="逐行式" GroupName="ScanMode" IsChecked="{Binding IsRowMajor}" Margin="0,0,14,6" />
                            <RadioButton Content="列行式" GroupName="ScanMode" IsChecked="{Binding IsColumnRow}" Margin="0,0,14,6" />
                            <RadioButton Content="行列式" GroupName="ScanMode" IsChecked="{Binding IsRowColumn}" Margin="0,0,14,6" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="阴码" GroupName="Polarity" IsChecked="{Binding IsNegativeCode}" Margin="0,0,16,0" />
                            <RadioButton Content="阳码" GroupName="Polarity" IsChecked="{Binding IsPositiveCode}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="顺向" GroupName="BitOrder" IsChecked="{Binding IsForward}" Margin="0,0,16,0" />
                            <RadioButton Content="逆向" GroupName="BitOrder" IsChecked="{Binding IsReversed}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="十六进制" GroupName="Radix" IsChecked="{Binding IsHex}" Margin="0,0,16,0" />
                            <RadioButton Content="十进制" GroupName="Radix" IsChecked="{Binding IsDecimal}" />
                        </StackPanel>

                        <TextBlock Text="字符集" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding CharsetNames}" SelectedIndex="{Binding CharsetIndex}" Margin="0,0,0,10" />

                        <TextBlock Text="渲染后端" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding RasterizerNames}" SelectedIndex="{Binding RasterizerIndex}" Margin="0,0,0,10" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="输出格式" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="格式" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding FormatNames}" SelectedIndex="{Binding FormatIndex}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="每行字节数" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding BytesPerLine, Mode=TwoWay}"
                                              Minimum="1" Maximum="80" SmallChange="1" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="在数据块前添加字符注释" IsChecked="{Binding AddCharComment}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 右侧预览与输出 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="文字" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15" Padding="8,6"
                             ToolTip="支持多字符，每个字符生成一个字模块" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="点阵预览" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CellSummary}" HorizontalAlignment="Right" Foreground="#7B8598" />
                    </Grid>
                    <Border Background="#111318" CornerRadius="6" Height="200">
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="8"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="LCD 仿真" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Border Background="#0A0F0C" CornerRadius="6" Height="132">
                        <Image Source="{Binding LcdImage}" Stretch="Uniform" Margin="8"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="字模数据" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox Grid.Row="1"
                             Text="{Binding OutputCode, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             FontFamily="{StaticResource CodeFont}"
                             FontSize="12"
                             Background="#12151B"
                             Foreground="#B9E4C9"
                             Padding="10"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#8A94A6" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="复制代码" Command="{Binding CopyCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="保存代码" Command="{Binding SaveTextCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="导出字库" Command="{Binding SaveBinaryCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="生成 GB2312 字库" Command="{Binding SaveLibraryCommand}" Appearance="Primary" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
