<Application x:Class="ModulusStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Theme="Dark" />
                <ui:ControlsDictionary xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas, Courier New</FontFamily>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#8A94A6" />
                <Setter Property="Margin" Value="0,14,0,6" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="#C6CDDA" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="PanelCard" TargetType="Border">
                <Setter Property="Background" Value="#1A1D23" />
                <Setter Property="BorderBrush" Value="#2A2F38" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
